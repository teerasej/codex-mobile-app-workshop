# Use this template only when you have no prepared api/.env; never overwrite a Student ZIP .env.
# API uses the restricted runtime login. Manual seed prompts for setup credentials separately.
# Obtain credentials privately; percent-encode each URI username/password component locally.
DATABASE_URL=postgresql://REPLACE_RUNTIME_USER:REPLACE_RUNTIME_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE?sslmode=require
JWT_SECRET=REPLACE_WITH_RANDOM_LOCAL_VALUE
CORS_ORIGINS=http://localhost:3000
APP_VERSION=v1
